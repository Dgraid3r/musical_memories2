SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Encrypts SpotifyToken.access_token/refresh_token at rest. Required -
# NOT the same format as JWT_SECRET_KEY, generate it with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Postgres connection string. Matches the `postgres` service in the
# project-root docker-compose.yml by default - override if you're pointing
# at a different instance.
DATABASE_URL=postgresql+psycopg://musical_memories:musical_memories@localhost:5432/musical_memories

# Required only for "Connect Spotify" account linking (GET /api/spotify/connect
# and /api/spotify/callback) - the app-only playlist search above doesn't need
# these. Must match a Redirect URI registered on this app in the Spotify
# developer dashboard exactly (including trailing slashes and scheme).
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/spotify/callback

# Where /api/spotify/callback sends the browser back to once linking
# finishes (or is denied). Defaults to the Vite dev server if unset.
FRONTEND_URL=http://localhost:5173

# Optional - error tracking (Sentry). Leave unset to disable entirely (no
# startup failure, just no error reporting).
SENTRY_DSN=

# Optional - log verbosity (DEBUG/INFO/WARNING/ERROR). Defaults to INFO.
LOG_LEVEL=INFO

# Optional - outgoing email (workspace invites, verify-your-email, and
# password reset links) via any SMTP provider, including a personal Gmail
# account (smtp.gmail.com, port 587, an App Password as SMTP_PASSWORD) or
# a transactional provider like Sendgrid/Mailgun/SES's SMTP endpoint.
# Leave SMTP_HOST unset to disable entirely, the same no-op pattern as
# SENTRY_DSN above: nothing fails, sending just logs the email's
# recipient/subject/body (including the real link/token) instead of
# actually delivering it - which is enough to develop and test the invite,
# verification, and password-reset flows locally without any mail setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER, then a placeholder, if left unset.
SMTP_FROM_ADDRESS=

# Optional - minimum seconds between outbound calls through the shared
# app-only Spotify search client (see "Spotify API" in the README).
# Defaults to 0.1 (10 req/s ceiling), generous headroom for personal/light
# use. Tighten this (e.g. 0.2 for ~5 req/s) if logs start showing frequent
# spotify.rate_limit_exhausted lines under real concurrent load.
SPOTIFY_SEARCH_MIN_INTERVAL_SECONDS=0.1
