SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional - "Sign in with Google" (an alternative to local email/password
# login, not a replacement - see README). Leave GOOGLE_CLIENT_ID unset to
# disable entirely, the same no-op pattern as SENTRY_DSN/SMTP_HOST below:
# nothing fails, the "Sign in with Google" button just doesn't appear.
# From an OAuth client in the Google Cloud Console (APIs & Services ->
# Credentials -> Create OAuth client ID -> Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI registered on that OAuth client
# exactly (including trailing slashes and scheme).
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Encrypts SpotifyToken.access_token/refresh_token at rest. Required -
# NOT the same format as JWT_SECRET_KEY, generate it with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Postgres connection string. Matches the `postgres` service in the
# project-root docker-compose.yml by default - override if you're pointing
# at a different instance.
DATABASE_URL=postgresql+psycopg://musical_memories:musical_memories@localhost:5432/musical_memories

# Required only for "Connect Spotify" account linking (GET /api/spotify/connect
# and /api/spotify/callback) - the app-only playlist search above doesn't need
# these. Must match a Redirect URI registered on this app in the Spotify
# developer dashboard exactly (including trailing slashes and scheme).
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/spotify/callback

# Where /api/spotify/callback sends the browser back to once linking
# finishes (or is denied). Defaults to the Vite dev server if unset.
FRONTEND_URL=http://localhost:5173

# Optional - error tracking (Sentry). Leave unset to disable entirely (no
# startup failure, just no error reporting).
SENTRY_DSN=

# Optional - log verbosity (DEBUG/INFO/WARNING/ERROR). Defaults to INFO.
LOG_LEVEL=INFO

# Optional - outgoing email (workspace invites, verify-your-email, and
# password reset links) via any SMTP provider, including a personal Gmail
# account (smtp.gmail.com, port 587, an App Password as SMTP_PASSWORD) or
# a transactional provider like Sendgrid/Mailgun/SES's SMTP endpoint.
# Leave SMTP_HOST unset to disable entirely, the same no-op pattern as
# SENTRY_DSN above: nothing fails, sending just logs the email's
# recipient/subject/body (including the real link/token) instead of
# actually delivering it - which is enough to develop and test the invite,
# verification, and password-reset flows locally without any mail setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER, then a placeholder, if left unset.
SMTP_FROM_ADDRESS=

# Optional - minimum seconds between outbound calls through the shared
# app-only Spotify search client (see "Spotify API" in the README).
# Defaults to 0.1 (10 req/s ceiling), generous headroom for personal/light
# use. Tighten this (e.g. 0.2 for ~5 req/s) if logs start showing frequent
# spotify.rate_limit_exhausted lines under real concurrent load.
SPOTIFY_SEARCH_MIN_INTERVAL_SECONDS=0.1

# Optional - object storage for entry photos, via any S3-compatible
# provider: AWS S3, Cloudflare R2, Backblaze B2, or a local MinIO
# container for dev/testing - not an AWS-specific SDK path, so any of
# these work unmodified. A low-cost option for personal-scale use is
# Cloudflare R2 (no egress fees): https://developers.cloudflare.com/r2/.
# Leave OBJECT_STORAGE_ENDPOINT_URL unset to keep storing photos on local
# disk instead (today's behavior - see backend/uploads/), the same no-op
# pattern as SENTRY_DSN/SMTP_HOST above: nothing fails, photos just save
# to and serve from disk. See "Entry photos" in the README for the
# one-time script that migrates existing local photos once you do
# configure this.
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Optional - most S3-compatible providers accept "auto"; set an exact
# region if yours requires one (AWS S3 does, e.g. "us-east-1").
OBJECT_STORAGE_REGION=auto

# Optional - database backups (see backend/scripts/backup_database.py
# and "Backups" in the README). Backups older than this many days are
# deleted after each run, whether they're stored locally or in object
# storage (same OBJECT_STORAGE_* config above - unset means local disk,
# which is NOT real off-machine protection, see the script's docstring).
BACKUP_RETENTION_DAYS=30

# Optional - how often the docker-compose backup sidecar runs, in
# seconds. Defaults to a day. Only relevant if you're using the `backup`
# service (docker compose --profile backup up -d) - has no effect when
# running backup_database.py yourself, e.g. via your own real cron.
BACKUP_INTERVAL_SECONDS=86400

# Optional - how often the docker-compose on-this-day sidecar runs, in
# seconds (see backend/scripts/send_on_this_day_reminders.py). Defaults
# to a day. Only relevant if you're using the `on-this-day` service
# (docker compose --profile on-this-day up -d) - the script itself is
# idempotent per user per real calendar day, so this only controls how
# promptly it notices a new day has started, not how often someone could
# be notified.
ON_THIS_DAY_INTERVAL_SECONDS=86400

# Optional - override how pg_dump/psql are invoked, if they're not
# plain "pg_dump"/"psql" on PATH (e.g. a full path on a host where the
# Postgres client tools live somewhere nonstandard). Leave unset in the
# normal case.
PG_DUMP_COMMAND=pg_dump
PSQL_COMMAND=psql
